# Copy to `supabase/.env.local` (gitignored) for the local stack.
# In hosted environments set these with `supabase secrets set`.

# ── Edge Function CORS ─────────────────────────────────────────────────
# Comma-separated origin allowlist. Never use "*": these endpoints accept a
# bearer token, and a wildcard lets any site on the internet call them with a
# token it has managed to steal.
ALLOWED_ORIGINS=http://localhost:5300,http://127.0.0.1:5300

# ── OAuth2 / OIDC providers ────────────────────────────────────────────
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://127.0.0.1:54321/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=

# GitHub:  https://github.com/settings/developers  (OAuth Apps)
#   Authorization callback URL: http://127.0.0.1:54321/auth/v1/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_SECRET=

# ── Rate limiting (Upstash Redis, sliding window) ──────────────────────
# Optional locally. When unset, the limiter falls back to the Postgres-backed
# limiter so local behaviour still exercises the same code path.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Third-party provider tokens (SRD Law 4) ─────────────────────────────
# JSON map of key version -> base64 32-byte AES-256-GCM key. Generate a new
# entry with:  openssl rand -base64 32
# Rotation: add a NEW highest version, deploy, run rotate-provider-keys, then
# remove the old version once nothing references it. Never edit a version's
# value in place — every ciphertext under it becomes permanently
# undecryptable, and the failure looks identical to tampering.
PROVIDER_TOKEN_KEYS={"1":""}
