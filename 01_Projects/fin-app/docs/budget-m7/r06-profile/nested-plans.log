{
  "Query Text": "WITH reporting AS (\n    SELECT t.*,coalesce(a.amount,t.amount)::bigint effective_amount,coalesce(a.kind,t.kind) allocated_kind\n    FROM public.budget_transactions_analytic t LEFT JOIN public.transaction_allocations a ON a.transaction_id=t.id AND a.tenant_id=t.tenant_id\n    WHERE t.tenant_id=p_tenant AND t.account_id=ANY(account_ids) AND t.date>=target_start AND t.date<target_end AND t.date<=as_of\n  ), effective AS (\n    SELECT *,CASE WHEN allocated_kind='transfer' AND kind_source='derived' AND transfer_state='rejected'\n      THEN CASE WHEN effective_amount>=0 THEN 'income' ELSE 'expense' END ELSE allocated_kind END effective_kind FROM reporting\n  ) SELECT coalesce(sum(CASE WHEN NOT pending AND NOT is_transfer AND effective_kind='expense' THEN greatest(-effective_amount,0) ELSE 0 END),0),\n    -coalesce(sum(CASE WHEN NOT pending AND NOT is_transfer AND effective_kind IN('refund','reimbursement') THEN greatest(effective_amount,0) ELSE 0 END),0)\n                               FROM effective",
