NOTICE:  duration: 165.272 ms  plan:
{
  "Query Text": "WITH reporting AS NOT MATERIALIZED (\n    SELECT t.date,t.account_id,t.merchant_key,coalesce(a.amount,t.amount)::bigint amount,coalesce(a.kind,t.kind) kind,t.kind_source,t.transfer_state,t.is_transfer,t.pending\n    FROM public.budget_transactions_analytic t\n    LEFT JOIN public.transaction_allocations a ON a.transaction_id=t.id AND a.tenant_id=t.tenant_id\n    WHERE t.tenant_id=p_tenant AND t.account_id=ANY(account_ids) AND t.date>=first_on AND t.date<start_on\n  ), effective AS MATERIALIZED (\n    SELECT *,CASE WHEN kind='transfer' AND kind_source='derived' AND transfer_state='rejected' THEN CASE WHEN amount>=0 THEN 'income' ELSE 'expense' END ELSE kind END effective_kind FROM reporting\n  ), sums AS (\n    SELECT p.start_date,\n      coalesce(sum(CASE WHEN NOT e.pending AND NOT e.is_transfer AND e.effective_kind='expense' THEN greatest(-e.amount,0) WHEN NOT e.pending AND NOT e.is_transfer AND e.effective_kind IN('refund','reimbursement') THEN -greatest(e.amount,0) ELSE 0 END),0) expense,\n      coalesce(sum(CASE WHEN EXISTS(SELECT 1 FROM assist_recurring r WHERE r.account_id=e.account_id AND r.merchant_key=e.merchant_key)\n        THEN CASE WHEN NOT e.pending AND NOT e.is_transfer AND e.effective_kind='expense' THEN greatest(-e.amount,0) WHEN NOT e.pending AND NOT e.is_transfer AND e.effective_kind IN('refund','reimbursement') THEN -greatest(e.amount,0) ELSE 0 END ELSE 0 END),0) recurring_expense,\n      coalesce(sum(CASE WHEN NOT e.pending AND NOT e.is_transfer AND e.effective_kind='income' THEN greatest(e.amount,0) ELSE 0 END),0) income,\n      coalesce(sum(CASE WHEN NOT e.pending AND NOT e.is_transfer AND e.effective_kind='expense' THEN greatest(-e.amount,0) ELSE 0 END),0) gross,\n      coalesce(sum(CASE WHEN NOT e.pending AND NOT e.is_transfer AND e.effective_kind IN('refund','reimbursement') THEN greatest(e.amount,0) ELSE 0 END),0) credits,\n      coalesce(sum(CASE WHEN NOT e.pending AND NOT e.is_transfer AND NOT EXISTS(SELECT 1 FROM assist_recurring r WHERE r.account_id=e.account_id AND r.merchant_key=e.merchant_key) AND e.effective_kind='expense' THEN greatest(-e.amount,0) ELSE 0 END),0) everyday_gross,\n      coalesce(sum(CASE WHEN NOT e.pending AND NOT e.is_transfer AND NOT EXISTS(SELECT 1 FROM assist_recurring r WHERE r.account_id=e.account_id AND r.merchant_key=e.merchant_key) AND e.effective_kind IN('refund','reimbursement') THEN greatest(e.amount,0) ELSE 0 END),0) everyday_credits\n    FROM assist_periods p LEFT JOIN effective e ON e.date>=p.start_date AND e.date<p.end_date GROUP BY p.start_date\n  ) UPDATE assist_periods p SET expense_cents=s.expense,recurring_expense_cents=s.recurring_expense,income_cents=s.income,gross_expense_cents=s.gross,expense_credit_cents=s.credits,everyday_gross_cents=s.everyday_gross,everyday_credit_cents=s.everyday_credits FROM sums s WHERE s.start_date=p.start_date",
