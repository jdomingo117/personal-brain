{
  "Query Text": "WITH claims AS MATERIALIZED(SELECT * FROM public.budget_live_claims(p_tenant,p_plan)),\n used AS(SELECT q.source_key,sum(q.amount_cents::numeric) FILTER(WHERE q.purpose='exclude' OR l.kind<>'everyday') amount,count(*) n FROM claims q LEFT JOIN public.budget_lines l ON l.id=q.line_id WHERE q.valid AND q.purpose<>'funding' GROUP BY q.source_key),\n raw AS NOT MATERIALIZED(\n  SELECT t.id parent_id,a.id child_id,t.account_id,t.date,t.merchant_key,t.pending,t.is_transfer,t.transfer_state,t.kind_source,coalesce(a.amount,t.amount)::bigint amount,coalesce(a.kind,t.kind) kind\n  FROM public.budget_transactions_analytic t LEFT JOIN public.transaction_allocations a ON a.transaction_id=t.id AND a.tenant_id=t.tenant_id\n  JOIN public.accounts ac ON ac.id=t.account_id AND ac.tenant_id=p_tenant AND ac.currency='AUD'\n  WHERE t.tenant_id=p_tenant AND t.account_id=ANY(accounts) AND t.date>=least(history_first,p.start_date) AND t.date<greatest(sample_until,cut)\n ), effective AS NOT MATERIALIZED(\n  SELECT *,CASE WHEN child_id IS NULL THEN 't:'||parent_id ELSE 'a:'||child_id END source_key,\n  CASE WHEN kind='transfer' AND kind_source='derived' AND transfer_state='rejected' THEN CASE WHEN amount<0 THEN 'expense' ELSE 'income' END ELSE kind END k FROM raw\n ), historical AS(\n  SELECT e.*,CASE WHEN coalesce(u.n,0)=0 AND EXISTS(SELECT 1 FROM jsonb_array_elements(policy) m WHERE m->>'account_id'=e.account_id::text AND m->>'merchant_key'=e.merchant_key) THEN 0 ELSE greatest(0,-e.amount::numeric-coalesce(u.amount,0)) END gross\n  FROM effective e LEFT JOIN used u USING(source_key) WHERE NOT e.pending AND NOT e.is_transfer AND e.k='expense' AND e.amount<0\n ), current_rows AS MATERIALIZED(SELECT a.*,greatest(0,a.capacity::numeric-coalesce(u.amount,0)) amount FROM (\n WITH rows AS (\n SELECT t.id parent_id,a.id allocation_id,t.date,t.pending,t.is_transfer,t.transfer_state,t.kind_source,\n coalesce(a.amount,t.amount)::bigint amount,coalesce(a.kind,t.kind) kind,\n coalesce(a.category_id,t.category_id) category_id,CASE WHEN a.id IS NULL THEN t.subcategory_id ELSE a.subcategory_id END subcategory_id,\n CASE WHEN a.id IS NULL THEN t.budget_custom_subcategory_id ELSE a.custom_subcategory_id END custom_subcategory_id\n FROM public.budget_transactions_analytic t LEFT JOIN public.transaction_allocations a ON a.tenant_id=t.tenant_id AND a.transaction_id=t.id\n \n JOIN public.accounts acct ON acct.id=t.account_id AND acct.tenant_id=t.tenant_id AND acct.currency='AUD'\n WHERE t.tenant_id=p_tenant AND t.date>=p.start_date AND t.date<cut AND EXISTS(\n SELECT 1 FROM public.budget_account_memberships m WHERE m.tenant_id=p_tenant AND m.plan_id=p_plan AND m.role='activity' AND m.account_id=t.account_id\n AND m.start_date<=t.date AND (m.end_date IS NULL OR m.end_date>t.date))\n ), effective AS (SELECT *,CASE WHEN kind='transfer' AND kind_source='derived' AND transfer_state='rejected' THEN CASE WHEN amount>=0 THEN 'income' ELSE 'expense' END ELSE kind END k FROM rows)\n SELECT CASE WHEN allocation_id IS NULL THEN 't:'||parent_id ELSE 'a:'||allocation_id END,\n CASE WHEN k='expense' THEN 'expense' ELSE 'refund' END,date,abs(amount),category_id,subcategory_id,custom_subcategory_id\n FROM effective WHERE NOT pending AND NOT is_transfer AND ((k='expense' AND amount<0) OR (k IN('refund','reimbursement') AND amount>0))) AS a(source_key,source_type,booking_date,capacity,category_id,subcategory_id,custom_subcategory_id) LEFT JOIN used u USING(source_key)),\n pending_rows AS(\n  SELECT -e.amount::numeric amount FROM effective e WHERE e.pending AND NOT e.is_transfer AND e.k='expense' AND e.amount<0 AND e.date>=p.start_date AND e.date<cut\n  AND EXISTS(SELECT 1 FROM public.budget_account_memberships m WHERE m.tenant_id=p_tenant AND m.plan_id=p_plan AND m.account_id=e.account_id AND m.role='activity' AND m.start_date<=e.date AND (m.end_date IS NULL OR m.end_date>e.date))\n  AND NOT EXISTS(SELECT 1 FROM jsonb_array_elements(policy) m WHERE m->>'account_id'=e.account_id::text AND m->>'merchant_key'=e.merchant_key)\n ), month_totals AS(\n  SELECT m sample,coalesce((SELECT sum(h.gross) FROM historical h WHERE h.date>=(m->>'start_date')::date AND h.date<(m->>'end_date')::date),0) gross FROM jsonb_array_elements(samples) m\n ) SELECT jsonb_build_object(\n  'samples',(SELECT coalesce(jsonb_agg(sample||jsonb_build_object('gross_cents',CASE WHEN gross<=9007199254740991 THEN gross ELSE NULL END) ORDER BY sample->>'start_date'),'[]') FROM month_totals),\n  'safe',NOT EXISTS(SELECT 1 FROM month_totals WHERE gross>9007199254740991),\n  'net',coalesce((SELECT sum(amount) FROM current_rows WHERE source_type='expense'),0)-coalesce((SELECT sum(amount_cents::numeric) FROM claims WHERE valid AND line_id=flex_id AND purpose='refund' AND source_date>=p.start_date AND source_date<cut),0),\n  'pending',coalesce((SELECT sum(amount) FROM pending_rows),0),\n  'integrity',NOT EXISTS(SELECT 1 FROM public.budget_transactions_analytic t WHERE t.tenant_id=p_tenant AND t.account_id=ANY(accounts) AND t.date>=least(history_first,p.start_date) AND t.date<greatest(sample_until,cut) AND t.transfer_candidate AND t.transfer_state IN('unmatched','suggested')) AND NOT EXISTS(SELECT 1 FROM claims WHERE NOT valid AND source_date>=least(history_first,p.start_date) AND source_date<greatest(sample_until,cut)),\n  'fixed',(SELECT coalesce(jsonb_agg(jsonb_build_object('line_id',x->>'line_id','net',coalesce((SELECT sum(CASE WHEN q.purpose='refund' THEN -q.amount_cents::numeric ELSE q.amount_cents::numeric END) FROM claims q WHERE q.valid AND q.line_id=(x->>'line_id')::uuid AND q.purpose IN('expense','purchase','refund') AND q.source_date>=p.start_date AND q.source_date<cut),0),\n   'occurrences',(SELECT coalesce(jsonb_agg(o||jsonb_build_object('matched_cents',coalesce((SELECT sum(q.amount_cents::numeric) FROM claims q JOIN public.budget_source_claims original ON original.id=q.id WHERE q.valid AND q.line_id=(x->>'line_id')::uuid AND q.purpose='expense' AND q.occurrence_date=(o->>'date')::date AND original.occurrence_revision_id=(x->'config'->>'schedule_id')::uuid AND q.source_date<cut),0)) ORDER BY o->>'date'),'[]') FROM jsonb_array_elements(x->'occurrences') o))),'[]') FROM jsonb_array_elements(d->'items') x WHERE x->>'kind'='fixed'))",
