# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# For local development these are printed by `npx supabase start`
# (run from 01_Projects/fin-app/). Use the API_URL and PUBLISHABLE_KEY it reports.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Private Budget preview only. Server BUDGET_V1_ENABLED is separately required for writes.
# Leave disabled on personal/production stacks until migration and release gates are approved.
VITE_BUDGET_V1_ENABLED=false
