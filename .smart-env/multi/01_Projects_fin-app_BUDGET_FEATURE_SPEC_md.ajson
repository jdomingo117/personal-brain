arch.com/hc/en-us/articles/32125337244052-Using-Flex-Budgeting","line":66},{"title":"The YNAB Method","target":"https://www.ynab.com/ynab-method","line":67},{"title":"Budget Rollovers, Copilot","target":"https://help.copilot.money/en/articles/3790828-budget-rollovers","line":68},{"title":"BUDGET_GUIDANCE_AND_GOALS.md","target":"BUDGET_GUIDANCE_AND_GOALS.md","line":156},{"title":"BUDGET_GUIDANCE_AND_GOALS.md","target":"BUDGET_GUIDANCE_AND_GOALS.md","line":218},{"title":"SYSTEM_INTEGRITY.md","target":"SYSTEM_INTEGRITY.md","line":681}],"class_name":"SmartBlock"},
